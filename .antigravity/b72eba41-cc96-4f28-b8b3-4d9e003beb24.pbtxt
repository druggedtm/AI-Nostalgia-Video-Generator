    file_change_type: FILE_CHANGE_TYPE_EDIT
    replacement_chunks {
      target_content: "  return (\n    <div className=\"bg-neutral-900 border-2 border-neutral-800 rounded-2xl p-6 shadow-xl relative overflow-hidden\">\n      <div className=\"absolute top-0 right-0 w-24 h-24 bg-amber-500/5 blur-2xl rounded-full\" />\n      \n      <div className=\"flex justify-between items-center mb-6\">\n        <div className=\"flex items-center gap-2\">\n          <Bookmark className=\"w-5 h-5 text-amber-500\" />\n          <h3 className=\"text-lg font-bold text-neutral-100 tracking-tight\">Saved Concept Rolls</h3>\n          <span className=\"bg-neutral-800 text-neutral-300 font-mono text-xs px-2 py-0.5 rounded-full border border-neutral-700\">\n            {savedScenes.length}\n          </span>\n        </div>\n        \n        {savedScenes.length > 0 && (\n          <button\n            onClick={onClearAll}\n            className=\"text-xs text-red-400 hover:text-red-300 transition-colors font-mono uppercase tracking-wider\"\n          >\n            Clear All\n          </button>\n        )}\n      </div>\n\n      <AnimatePresence mode=\"popLayout\">\n        {savedScenes.length === 0 ? (\n          <motion.div\n            initial={{ opacity: 0 }}\n            animate={{ opacity: 1 }}\n            className=\"text-center py-12 border-2 border-dashed border-neutral-800/80 rounded-xl\"\n          >\n            <Bookmark className=\"w-8 h-8 text-neutral-700 mx-auto mb-2 stroke-[1.5]\" />\n            <p className=\"text-neutral-400 text-sm font-medium\">No concepts saved yet</p>\n            <p className=\"text-neutral-600 text-xs px-4 mt-1.5 leading-relaxed\">\n              Click \"Save Concept\" on any generated scene card above to queue it in your workspace drawer!\n            </p>\n          </motion.div>\n        ) : (\n          <div className=\"space-y-4 max-h-[500px] overflow-y-auto pr-1.5 scrollbar-thin\">\n            {savedScenes.map((item) => (\n              <motion.div\n                key={item.id}\n                layout\n                initial={{ opacity: 0, scale: 0.95 }}\n                animate={{ opacity: 1, scale: 1 }}\n                exit={{ opacity: 0, scale: 0.95 }}\n                transition={{ duration: 0.2 }}\n                className=\"bg-neutral-950/70 border border-neutral-800/80 p-4 rounded-xl space-y-3 relative group\"\n              >\n                {/* Meta details */}\n                <div className=\"flex justify-between items-start gap-4\">\n                  <div>\n                    <span className=\"text-[10px] font-mono bg-amber-500/10 border border-amber-500/20 text-text-amber-500 text-amber-500 px-1.5 py-0.5 rounded uppercase tracking-wide mr-2\">\n                      Scene {item.scene.number}\n                    </span>\n                    <span className=\"text-[10px] font-mono text-neutral-500 uppercase tracking-widest\">\n                      {item.decade || \"Custom theme\"}\n                    </span>\n                    <h4 className=\"text-neutral-200 text-sm font-bold mt-1 tracking-tight\">\n                      {item.scene.title}\n                    </h4>\n                  </div>\n\n                  <div className=\"flex items-center gap-1.5\">\n                    <button\n                      onClick={() => handleCopy(item.id, `\360\237\223\267 IMAGE PROMPT:\\n${item.scene.imagePrompt}\\n\\n\360\237\216\245 VIDEO PROMPT:\\n${item.scene.videoPrompt}`)}\n                      className=\"text-neutral-400 hover:text-white p-1.5 hover:bg-neutral-800 rounded transition-colors\"\n                      title=\"Copy Prompts Suite\"\n                    >\n                      {copiedId === item.id ? (\n                        <Check className=\"w-3.5 h-3.5 text-green-500\" />\n                      ) : (\n                        <Copy className=\"w-3.5 h-3.5\" />\n                      )}\n                    </button>\n                    \n                    <button\n                      onClick={() => onRemove(item.id)}\n    