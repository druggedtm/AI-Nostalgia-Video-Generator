           onClick={() => handleCopyText(videoPromptText, setCopiedVid)}\n                  className=\"text-neutral-400 hover:text-amber-500 text-xs flex items-center gap-1 font-mono transition-colors\"\n                >\n                  {copiedVid ? (\n                    <>\n                      <Check className=\"w-3.5 h-3.5 text-green-500\" />\n                      <span className=\"text-green-500 font-bold\">COPIED</span>\n                    </>\n                  ) : (\n                    <>\n                      <Copy className=\"w-3.5 h-3.5\" />\n                      <span>Copy</span>\n                    </>\n                  )}\n                </button>\n              </div>\n              <div className=\"bg-neutral-950 p-3 rounded-lg border border-neutral-800 text-xs text-neutral-300 font-mono leading-relaxed select-all hover:border-neutral-700 transition-colors h-24 overflow-y-auto scrollbar-thin\">\n                {videoPromptText}\n              </div>\n            </div>\n\n          </div>\n\n          {/* Magic Frame & Generation */}\n          <div className=\"border border-neutral-800 rounded-xl bg-neutral-950 p-4 space-y-4\">\n            \n            {/* Visual Screen Container */}\n            <div className=\"relative aspect-video rounded-lg overflow-hidden bg-neutral-900 border border-neutral-800 flex flex-col items-center justify-center text-center\">\n              \n              {/* Retro Viewport Grid Overlay */}\n              <div className=\"absolute inset-0 bg-retro-scanlines opacity-25 pointer-events-none\" />\n\n              <AnimatePresence mode=\"wait\">\n                {isGeneratingImg ? (\n                  <motion.div\n                    key=\"generating\"\n                    initial={{ opacity: 0 }}\n                    animate={{ opacity: 1 }}\n                    exit={{ opacity: 0 }}\n                    className=\"flex flex-col items-center gap-2 p-4 text-center z-10\"\n                  >\n           