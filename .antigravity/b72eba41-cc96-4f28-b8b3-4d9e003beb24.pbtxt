      target_content: "            {/* The Control Desk Container */}\n            <div className=\"bg-neutral-900 border-2 border-neutral-800 rounded-3xl p-6 sm:p-8 space-y-6 shadow-xl relative overflow-hidden\">\n              <div className=\"absolute top-0 right-0 w-32 h-32 bg-amber-500/5 blur-3xl rounded-full\" />\n              \n              <div className=\"border-b border-neutral-800 pb-4 flex justify-between items-center\">\n                <div className=\"flex items-center gap-2\">\n                  <Compass className=\"w-5.5 h-5.5 text-amber-500\" />\n                  <h3 className=\"text-lg font-bold text-neutral-100 tracking-tight\">Concept Director Deck</h3>\n                </div>\n                <span className=\"text-xs font-mono text-neutral-500\">Configure parameters below:</span>\n              </div>\n\n              {/* Decide Decades OR custom theme */}\n              <div className=\"space-y-5\">\n                <div>\n                  <label className=\"text-xs font-mono text-neutral-400 uppercase tracking-wider block mb-3.5\">\n                    Step 1: Choose Target Decade Group OR custom theme\n                  </label>\n                  \n                  {/* Decade buttons */}\n                  <div className=\"grid grid-cols-2 sm:grid-cols-5 gap-2.5\">\n                    {DECADE_PRESETS.map((dec) => (\n                      <button\n                        key={dec.id}\n                        onClick={() => {\n                          setSelectedDecade(dec.id);\n                          setCustomTheme(\"\"); // clear custom\n                        }}\n                        className={`p-3.5 rounded-xl border text-center flex flex-col items-center justify-center gap-1.5 transition-all text-xs cursor-pointer ${\n                          selectedDecade === dec.id\n                            ? \"bg-amber-500/10 border-amber-500 shadow-lg text-amber-500\"\n                            : \"bg-neutral-950 border-neutral-800 text-neutral-300 hover:border-neutral-700\"\n                        }`}\n                        title={dec.description}\n                      >\n                        <span className=\"text-xl\">{dec.icon}</span>\n                        <span className=\"font-bold tracking-tight\">{dec.label}</span>\n                      </button>\n                    ))}\n                  </div>\n                </div>\n\n                {/* Theme suggestions */}\n                <div>\n                  <div className=\"flex justify-between items-center mb-2.5\">\n                    <span className=\"text-xs font-mono text-neutral-500 uppercase tracking-wider\">\n                      Or Select a Quick Creative Theme Preset:\n                    </span>\n                    {customTheme && (\n                      <button\n                        onClick={() => setCustomTheme(\"\")}\n                        className=\"text-[11px] text-neutral-400 hover:text-white font-mono\"\n                      >\n                        Reset Suggested Theme\n                      </button>\n                    )}\n                  </div>\n\n                  <div className=\"grid grid-cols-2 gap-2 max-h-[140px] overflow-y-auto pr-1.5 scrollbar-thin\">\n                    {THEME_PRESETS.map((themePreset) => (\n                      <button\n                        key={themePreset.id}\n                        onClick={() => handleSelectThemePreset(themePreset)}\n                        className={`p-2.5 rounded-lg border text-left flex items-center gap-3 transition-all text-xs cursor-pointer ${\n                          customTheme === themePreset.theme\n                            ? \"bg-amber-500/10 border-amber-500 text-amber-500\"\n                            : \"bg-neutral-950 border-neutral-800 text-neutral-300 hover:border-neutral-700\"\n                        }`}\n                      >\n                        <span className=\"text-lg shrink-0\">{themePreset.icon}</span>\n                        <div className=\"truncate\">\n                          <p className=\"font-bold tracking-tight truncate\">{themePreset.label}</p>\n                          <p className=\"text-[10px] text-neutral-400 truncate mt-0.5\">{themePreset.description}</p>\n                        </div>\n                      </button>\n                    ))}\n                  </div>\n                </div>\n\n                {/* Custom input box */}\n                <div className=\"bg-neutral-950 p-4 rounded-xl border border-neutral-800\">\n                  <div className=\"flex gap-2\">\n                    <input\n                      type=\"text\"\n                      placeholder=\"Mix a custom trigger (e.g., slurping a blue slushee in 1993, blowing Nintendo cartridges...)\"\n                      value={customTheme}\n                      onChange={(e) => {\n                        setCustomTheme(e.target.value);\n                        setSelectedDecade(null); // disable rigid decade selection\n                      }}\n                      className=\"flex-1 bg-neutral-900 border border-neutral-800 rounded-lg py-2.5 px-3.5 text-sm text-white placeholder-neutral-600 focus:outline-none focus:border-amber-500/50\"\n                    />\n                  </div>\n                  <p className=\"text-[10px] font-mono text-neutral-500 mt-2 block\">\n                    Custom triggers bypass rigid decade presets and generate fine-tuned, historically optimized prompts.\n                  </p>\n                </div>\n\n                {/* Dropdowns details */}\n                <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-4\">\n                  <div>\n                    <label className=\"text-xs font-mono text-neutral-400 uppercase tracking-wider block mb-2\">\n                      \360\237\221\246 Target Age/Demographic:\n                    </label>\n                    <select\n                      value={selectedAudience}\n                      onChange={(e) => setSelectedAudience(e.target.value)}\n                      className=\"w-full bg-neutral-950 border border-neutral-800 text-neutral-200 py-2 px-3 rounded-lg text-xs font-mono tracking-tight focus:outline-none focus:border-amber-500/50\"\n                    >\n                      {AUDIENCE_PRESETS.map(aud => (\n                        <option key={aud.id} value={aud.id}>\n                          {aud.icon} {aud.label} ({aud.description})\n                        </option>\n                      ))}\n                    </select>\n                  </div>\n\n                  <div>\n                    <label className=\"text-xs font-mono text-neutral-400 uppercase tracking-wider block mb-2\">\n                      \360\237\214\215 Country Regional Flavor:\n                    </label>\n                    <select\n                      value={selectedRegion}\n                      onChange={(e) => setSelectedRegion(e.target.value)}\n                      className=\"w-full bg-neutral-950 border border-neutral-800 text-neutral-200 py-2 px-3 rounded-lg text-xs font-mono tracking-tight focus:outline-none focus:border-amber-500/50\"\n                    >\n                      {REGION_PRESETS.map(reg => (\n                        <option key={reg.id} value={reg.id}>\n                          {reg.code} {reg.label}\n                        </option>\n                      ))}\n                    </select>\n                  </div>\n                </div>\n\n              </div>\n\n              {/* Launch Ticker Engine */}\n              <div className=\"pt-4 border-t border-dashed border-neutral-800\">\n                <button\n                  onClick={handleGenerate}\n                  disabled={isGenerating}\n                  className=\"w-full bg-amber-500 hover:bg-amber-400 text-neutral-950 font-black py-4 rounded-2xl tracking-wider text-sm font-mono flex items-center justify-center gap-2 cursor-pointer shadow-lg active:scale-[0.99] transition-all disabled:opacity-50\"\n                >\n                  <Tv className=\"w-5 h-5 text-neutral-950 stroke-[2] animate-pulse\" />\n                  GENERATE NOSTALGIC SCENE ROLLS\n                  <ArrowRight className=\"w-4 h-4 text-neutral-950\" />\n                </button>\n              </div>"
      replacement_content: "            {/* The Control Desk Container */}\n            <div className=\"bg-[#0f0f0f] border border-white/10 rounded-2xl p-6 sm:p-8 space-y-6 shadow-xl relative overflow-hidden\">\n              <div className=\"absolute top-0 right-0 w-32 h-32 bg-amber-500/5 blur-3xl rounded-full\" />\n              \n              <div className=\"border-b border-white/5 pb-4 flex justify-between items-center\">\n                <div className=\"flex items-center gap-2\">\n                  <Compass className=\"w-4 h-4 text-amber-500\" />\n                  <h3 className=\"text-sm uppercase tracking-widest text-neutral-400 font-mono\">Generation Parameters</h3>\n                </div>\n                <span className=\"text-[10px] font-mono text-neutral-500 uppercase tracking-wider\">Configure Focus</span>\n              </div>\n\n              {/* Decide Decades OR custom theme */}\n              <div className=\"space-y-5\">\n                <div>\n                  <label className=\"text-[11px] font-mono text-neutral-400 uppercase tracking-widest block mb-3\">\n                    Target Decade Group\n                  </label>\n                  \n                  {/* Decade buttons */}\n                  <div className=\"grid grid-cols-2 sm:grid-cols-5 gap-2.5\">\n                    {DECADE_PRESETS.map((dec) => (\n                      <button\n                        key={dec.id}\n                        onClick={() => {\n                          setSelectedDecade(dec.id);\n                          setCustomTheme(\"\"); // clear custom\n                        }}\n                        className={`p-3 rounded border text-center flex flex-col items-center justify-center gap-1 transition-all text-xs cursor-pointer ${\n                          selectedDecade === dec.id\n                            ? \"bg-amber-500/10 border-amber-500 text-amber-500 font-semibold\"\n                            : \"bg-neutral-900 border-white/5 text-neutral-400 hover:border-white/15 hover:text-neutral-200\"\n                        }`}\n                        title={dec.description}\n                      >\n                        <span className=\"text-lg\">{dec.icon}</span>\n                        <span className=\"font-mono tracking-wider\">{dec.label}</span>\n                      </button>\n                    ))}\n                  </div>\n                </div>\n\n                {/* Theme suggestions */}\n                <div>\n                  <div className=\"flex justify-between items-center mb-2.5\">\n                    <span className=\"text-[10px] font-mono text-neutral-500 uppercase tracking-widest\">\n                      Select a Quick Theme Hook Blueprint:\n                    </span>\n                    {customTheme && (\n                      <button\n                        onClick={() => setCustomTheme(\"\")}\n                        className=\"text-[10px] text-amber-500 hover:text-amber-400 font-mono uppercase tracking-wider\"\n                      >\n                        Reset Theme Hook\n                      </button>\n                    )}\n                  </div>\n\n                  <div className=\"grid grid-cols-2 gap-2 max-h-[140px] overflow-y-auto pr-1.5 scrollbar-thin\">\n                    {THEME_PRESETS.map((themePreset) => (\n                      <button\n                        key={themePreset.id}\n                        onClick={() => handleSelectThemePreset(themePreset)}\n                        className={`p-2.5 rounded border text-left flex items-start gap-3 transition-all text-xs cursor-pointer ${\n                          customTheme === themePreset.theme\n                            ? \"bg-amber-500/15 border-amber-500/60 text-amber-500\"\n                            : \"bg-[#0a0a0a] border-white/5 text-neutral-400 hover:border-white/10\"\n                        }`}\n                      >\n                        <span className=\"text-lg shrink-0 mt-0.5\">{themePreset.icon}</span>\n                        <div className=\"truncate\">\n                          <p className=\"font-serif italic text-neutral-200 font-semibold leading-tight truncate\">{themePreset.label}</p>\n                          <p className=\"text-[10px] text-neutral-500 truncate mt-0.5\">{themePreset.description}</p>\n                        </div>\n                      </button>\n                    ))}\n                  </div>\n                </div>\n\n                {/* Custom input box */}\n                <div className=\"bg-[#0a0a0a]/80 p-4 rounded border border-white/5\">\n                  <div className=\"flex gap-2\">\n                    <input\n                      type=\"text\"\n                      placeholder=\"Mix custom triggers (e.g., slurping a blue slushee in 1993, holding a Nokia 3310...)\"\n                      value={customTheme}\n                      onChange={(e) => {\n                        setCustomTheme(e.target.value);\n                        setSelectedDecade(null); // disable rigid decade selection\n                      }}\n                      className=\"flex-1 bg-neutral-900 border border-white/10 rounded py-2 px-3.5 text-xs text-white placeholder-neutral-600 focus:outline-none focus:border-amber-500/50 focus:ring-0\"\n                    />\n                  </div>\n                  <p className=\"text-[9px] font-mono text-neutral-600 uppercase tracking-wider mt-2 block\">\n                    Custom triggers bypass static decade scopes and refine historical contextual features.\n                  </p>\n                </div>\n\n                {/* Dropdowns details */}\n                <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-4\">\n                  <div>\n                    <label className=\"text-[10px] font-mono text-neutral-500 uppercase tracking-widest block mb-2\">\n                      Target Audience Archetype\n                    </label>\n                    <select\n                      value={selectedAudience}\n                      onChange={(e) => setSelectedAudience(e.target.value)}\n                      className=\"w-full bg-[#0a0a0a] border border-white/10 text-neutral-300 py-2 px-3 rounded text-xs font-mono focus:outline-none focus:border-amber-500/50\"\n                    >\n                      {AUDIENCE_PRESETS.map(aud => (\n                        <option key={aud.id} value={aud.id} className=\"bg-neutral-950\">\n                          {aud.icon} {aud.label}\n                        </option>\n                      ))}\n                    </select>\n                  </div>\n\n                  <div>\n                    <label className=\"text-[10px] font-mono text-neutral-500 uppercase tracking-widest block mb-2\">\n                      Regional Dialect Flavor\n                    </label>\n                    <select\n                      value={selectedRegion}\n                      onChange={(e) => setSelectedRegion(e.target.value)}\n                      className=\"w-full bg-[#0a0a0a] border border-white/10 text-neutral-300 py-2 px-3 rounded text-xs font-mono focus:outline-none focus:border-amber-500/50\"\n                    >\n                      {REGION_PRESETS.map(reg => (\n                        <option key={reg.id} value={reg.id} className=\"bg-neutral-950\">\n                          {reg.code} {reg.label}\n                        </option>\n                      ))}\n                    </select>\n                  </div>\n                </div>\n\n              </div>\n\n              {/* Launch Ticker Engine */}\n              <div className=\"pt-4 border-t border-white/5\">\n                <button\n                  onClick={handleGenerate}\n                  disabled={isGenerating}\n                  className=\"w-full bg-amber-500 hover:bg-amber-400 text-black font-bold py-3.5 rounded text-xs font-mono tracking-widest uppercase flex items-center justify-center gap-2 cursor-pointer shadow-lg active:scale-[0.99] transition-all disabled:opacity-50\"\n                >\n                  <RefreshCw className={`w-3.5 h-3.5 text-black ${isGenerating ? \'animate-spin\' : \'\'}`} />\n                  Generate Nostalgic Sequence\n                  <ArrowRight className=\"w-3.5 h-3.5 text-black\" />\n                </button>\n              </div>"
