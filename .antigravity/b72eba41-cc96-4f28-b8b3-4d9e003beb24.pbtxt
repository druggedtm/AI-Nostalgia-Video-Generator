ssName=\"grid grid-cols-1 sm:grid-cols-2 gap-3\">\n              <div className=\"p-3 bg-neutral-900/40 rounded border border-white/5\">\n                <span className=\"text-[9px] font-mono text-neutral-500 block uppercase tracking-widest mb-1\">\360\237\226\220\357\270\217 Breathing Micro-Action</span>\n                <p className=\"text-neutral-300 text-xs font-light\">{localMovement}</p>\n              </div>\n              <div className=\"p-3 bg-neutral-900/40 rounded border border-white/5\">\n                <span className=\"text-[9px] font-mono text-neutral-500 block uppercase tracking-widest mb-1\">\342\232\241 Dynamic Aura Shift</span>\n                <p className=\"text-neutral-300 text-xs font-light\">{localLightChange}</p>\n              </div>\n            </div>\n          </div>"
