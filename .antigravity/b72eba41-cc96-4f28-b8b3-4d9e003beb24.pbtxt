        target_content: "                    <span className=\"text-xs font-mono text-amber-500 tracking-wider\">DEVELOPING 35MM REELS...</span>\n                    {/* Retro Progress bar animation */}\n                    <div className=\"w-32 h-1 bg-neutral-800 rounded-full overflow-hidden mt-1\">\n                      <div className=\"h-full bg-amber-500 animate-loading-bar\" />\n                    </div>\n                    <span className=\"text-[10px] text-neutral-500 font-mono\">Generates base negative via gemini-2.5-flash-image</span>\n                  </motion.div>\n                ) : previewImage ? (\n                  <motion.div\n                    key=\"image\"\n                    initial={{ opacity: 0 }}\n                    animate={{ opacity: 1 }}\n                    className=\"w-full h-full relative\"\n                  >\n                    <img\n                      src={previewImage}\n                      alt=\"Nostalgic POV visual scene render\"\n                      className=\"w-full h-full object-cover\"\n                      referrerPolicy=\"no-referrer\"\n                    />\n                    <div className=\"absolute bottom-2 left-2 bg-black/80 backdrop-blur-md px-2 py-0.5 rounded border border-neutral-800 text-[9px] font-mono text-amber-400\">\n                      POV MODEL ACTIVE RENDER 1.0\n                    </div>\n                  </motion.div>\n                ) : (\n                  <motion.div\n                    key=\"placeholder\"\n                    initial={{ opacity: 0 }}\n                    animate={{ opacity: 1 }}\n                    className=\"p-5 flex flex-col items-center gap-1.5 text-center text-neutral-500\"\n                  >\n                    <Tv className=\"w-10 h-10 stroke-[1.5] text-neutral-600\" />\n                    <p className=\"text-xs font-mono font-bold text-neutral-400\">CRT POV SCREEN SHOT</p>\n                    <p className=\"text-[11px] text-neutral-500 max-w-xs leading-normal\">\n                      Click below to generate a real AI image draft using your generated specs.\n                    </p>\n                    {previewError && (\n                      <div className=\"mt-1 px-2.5 py-1 rounded bg-red-950/40 border border-red-900/40 text-[10px] text-red-400 font-mono\">\n                        {previewError}\n                      </div>\n                    )}\n                  </motion.div>\n                )}\n              </AnimatePresence>\n            </div>\n\n            {/* Render and Script copy controls */}\n            <div className=\"flex gap-2.5 flex-wrap\">\n              <button\n                onClick={handleGeneratePreview}\n                disabled={isGeneratingImg}\n                className=\"flex-1 min-w-[150px] bg-amber-500 hover:bg-amber-400 text-neutral-950 font-bold px-3.5 py-2 rounded-lg text-xs font-mono transition-all flex items-center justify-center gap-2 cursor-pointer shadow-lg active:scale-[0.98] disabled:opacity-50\"\n              >\n                <Sparkles className=\"w-4 h-4 text-neutral-950\" />\n                {previewImage ? \"Regenerate Render\" : \"Generate Draft Preview\"}\n              </button>\n\n              <button\n                onClick={handleCopyScriptBundle}\n                className=\"bg-neutral-800 hover:bg-neutral-700 text-neutral-200 border border-neutral-700 px-3.5 py-2 rounded-lg text-xs font-semibold tracking-wide transition-all flex items-center justify-center gap-2 cursor-pointer\"\n                title=\"Copy ready-to-post script with visual hashtags & specs\"\n              >\n                {copiedScript ? (\n                  <>\n                    <Check className=\"w-4 h-4 text-green-500\" />\n                    <span className=\"text-green-500\">Copied Bundle</span>\n                  </>\n                ) : (\n                  <>\n                    <FileText className=\"w-4 h-4\" />\n                    <span>Copy Reels Bundle</span>\n                  </>\n                )}\n              </button>\n            </div>"
        replacement_content: "                    <span className=\"text-[10px] font-mono text-amber-500 tracking-widest uppercase\">DEVELOPING 35MM REELS...</span>\n                    {/* Retro Progress bar animation */}\n                    <div className=\"w-32 h-[1px] bg-neutral-900 overflow-hidden mt-1 col-span-2\">\n                      <div className=\"h-full bg-amber-500 animate-loading-bar\" />\n                    </div>\n                    <span className=\"text-[9px] text-neutral-500 font-mono uppercase tracking-widest\">via gemini-2.5-flash-image</span>\n                  </motion.div>\n                ) : previewImage ? (\n                  <motion.div\n                    key=\"image\"\n                    initial={{ opacity: 0 }}\n                    animate={{ opacity: 1 }}\n                    className=\"w-full h-full relative\"\n                  >\n                    <img\n                      src={previewImage}\n                      alt=\"Nostalgic POV visual scene render\"\n                      className=\"w-full h-full object-cover\"\n                      referrerPolicy=\"no-referrer\"\n                    />\n                    <div className=\"absolute bottom-2 left-2 bg-black/80 backdrop-blur-md px-2 py-0.5 border border-white/10 text-[9px] font-mono text-amber-500\">\n                      POV MODEL ACTIVE RENDER 1.0\n                    </div>\n                  </motion.div>\n                ) : (\n                  <motion.div\n                    key=\"placeholder\"\n                    initial={{ opacity: 0 }}\n                    animate={{ opacity: 1 }}\n                    className=\"p-5 flex flex-col items-center gap-1.5 text-center text-neutral-500\"\n                  >\n                    <Tv className=\"w-8 h-8 stroke-[1.5] text-neutral-700\" />\n                    <p className=\"text-[10px] font-mono font-bold text-neutral-400 uppercase tracking-widest\">CRT POV Screen Viewport</p>\n                    <p className=\"text-[11px] text-neutral-500 max-w-xs leading-normal\">\n                      Click below to generate an AI visual drafting frame of this scene composition.\n                    </p>\n                    {previewError && (\n                      <div className=\"mt-1 px-2 py-0.5 rounded bg-red-950/40 border border-red-900/40 text-[9px] text-red-400 font-mono\">\n                        {previewError}\n                      </div>\n                    )}\n                  </motion.div>\n                )}\n              </AnimatePresence>\n            </div>\n\n            {/* Render and Script copy controls */}\n            <div className=\"flex gap-2 flex-wrap\">\n              <button\n                onClick={handleGeneratePreview}\n                disabled={isGeneratingImg}\n                className=\"flex-1 min-w-[150px] bg-amber-500 hover:bg-amber-400 text-black font-semibold px-3.5 py-2 rounded text-[11px] font-mono uppercase tracking-wider transition-all flex items-center justify-center gap-1.5 cursor-pointer shadow-lg active:scale-[0.98] disabled:opacity-50\"\n              >\n                <Sparkles className=\"w-3.5 h-3.5 text-black\" />\n                {previewImage ? \"Regenerate Render\" : \"Generate Draft Preview\"}\n              </button>\n\n              <button\n                onClick={handleCopyScriptBundle}\n                className=\"bg-neutral-900 hover:bg-neutral-800 text-white border border-white/5 px-3.5 py-2 rounded text-[11px] font-semibold uppercase tracking-wider transition-all flex items-center justify-center gap-1.5 cursor-pointer\"\n                title=\"Copy ready-to-post script with visual hashtags & specs\"\n              >\n                {copiedScript ? (\n                  <>\n                    <Check className=\"w-3.5 h-3.5 text-green-500\" />\n                    <span className=\"text-green-500\">Copied Bundle</span>\n                  </>\n                ) : (\n                  <>\n                    <FileText className=\"w-3.5 h-3.5 text-neutral-400\" />\n                    <span>Copy Reels Bundle</span>\n                  </>\n                )}\n              </button>\n            </div>"
