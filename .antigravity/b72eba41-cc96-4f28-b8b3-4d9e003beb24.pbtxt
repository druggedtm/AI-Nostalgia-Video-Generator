    replacement_infos {
      original_chunk {
        target_content: "  return (\n    <div className=\"bg-[#0c0d0e] text-neutral-100 min-h-screen selection:bg-amber-500 selection:text-neutral-900 pb-20 font-sans relative\">\n      \n      {/* Dynamic Background Noise Overlay */}\n      <div className=\"fixed inset-0 pointer-events-none bg-retro-scanlines opacity-[0.03]\" />\n\n      {/* Retro Signal Header */}\n      <header className=\"border-b border-neutral-800 bg-neutral-950/80 backdrop-blur-md sticky top-0 z-40 px-6 py-4\">\n        <div className=\"max-w-7xl mx-auto flex flex-wrap justify-between items-center gap-4\">\n          \n          <div className=\"flex items-center gap-4\">\n            <div className=\"relative w-10 h-10 rounded-xl bg-gradient-to-br from-amber-500 to-amber-700 flex items-center justify-center shadow-lg shadow-amber-500/10\">\n              <Tv className=\"w-5.5 h-5.5 text-neutral-950 stroke-[2]\" />\n              <div className=\"absolute top-1 right-1 w-2 h-2 bg-neutral-100 animate-ping rounded-full\" />\n            </div>\n            <div>\n              <div className=\"flex items-center gap-2\">\n                <h1 className=\"text-xl font-bold uppercase tracking-tight text-neutral-100 font-sans\">\n                  AI Nostalgia Video Generator\n                </h1>\n                <span className=\"text-[10px] bg-amber-500/10 border border-amber-500/30 text-amber-500 font-mono px-1.5 py-0.5 rounded uppercase font-semibold\">\n                  POV Beta 1.9\n                </span>\n              </div>\n              <p className=\"text-xs text-neutral-400\">Viral First-Person Nostalgia Creator Workspace</p>\n            </div>\n          </div>\n\n          {/* Immersive HUD data */}\n          <div className=\"flex items-center gap-6 text-xs text-neutral-400 font-mono\">\n            <div className=\"hidden sm:block\">\n              <span className=\"text-neutral-500\">INGRESS LINK:</span>{\" \"}\n              <span className=\"text-amber-500 font-bold\">STATION_3000</span>\n            </div>\n            \n            <div className=\"flex items-center gap-1.5 bg-neutral-900 border border-neutral-800 px-3 py-1.5 rounded-lg\">\n              <Clock className=\"w-3.5 h-3.5 text-neutral-500\" />\n              <span>{currentTime || \"00:00:00\"}</span>\n            </div>\n          </div>\n\n        </div>\n      </header>\n\n      {/* Main Workspace Frame */}\n      <main className=\"max-w-7xl mx-auto px-6 pt-8\">\n        \n        {/* Banner */}\n        <div className=\"bg-gradient-to-r from-neutral-900 via-neutral-900 to-amber-950/20 border-2 border-neutral-800 rounded-3xl p-6 sm:p-8 mb-8 relative overflow-hidden flex flex-col md:flex-row items-center gap-6 shadow-2xl\">\n          <div className=\"absolute inset-x-0 bottom-0 h-0.5 bg-gradient-to-r from-amber-500 via-yellow-500 to-transparent opacity-40\" />\n          \n          <div className=\"space-y-3 max-w-2xl text-center md:text-left\">\n            <div className=\"inline-flex items-center gap-1.5 bg-amber-500/10 border border-amber-500/20 text-amber-500 text-[10px] font-mono uppercase font-black px-2.5 py-1 rounded-full\">\n              <Sparkles className=\"w-3 h-3\" /> Viral POV Director Blueprint\n            </div>\n            <h2 className=\"text-2xl sm:text-3xl font-extrabold tracking-tight text-neutral-100\">\n              Generate Highly Emotional, Nostalgic POV Scene Prompts\n            </h2>\n            <p className=\"text-neutral-400 text-sm leading-relaxed\">\n              These generated concepts utilize a scientifically designed <b>POV formula</b> optimized to strike a chord\n              with Western millennials and Gen-X demographics on TikTok and Reels. All prompts focus with hyper-demographic accuracy on nostalgic hand/foreground interactions.\n            </p>\n          </div>\n\n          <div className=\"md:ml-auto flex items-center justify-center bg-neutral-950 p-4 rounded-2xl border border-neutral-800 min-w-[200px] text-center shrink-0\">\n            <div className=\"space-y-1\">\n              <p className=\"text-[10px] text-neutral-500 font-mono uppercase tracking-widest\">Active Models</p>\n              <p className=\"text-sm font-bold text-neutral-100 font-mono\">Gemini 3.5 Flash</p>\n              <div className=\"h-px bg-neutral-800 my-2\" />\n              <p className=\"text-[10px] text-neutral-500 font-mono uppercase tracking-widest\">Render Anchor</p>\n              <p className=\"text-xs text-amber-400 font-mono\">Gemini 2.5 Flash Image</p>\n            </div>\n          </div>\n        </div>"
        replacement_content: "  return (\n    <div className=\"bg-[#0a0a0a] text-neutral-300 min-h-screen selection:bg-amber-500 selection:text-neutral-900 pb-20 font-sans relative\">\n      \n      {/* Dynamic Background Noise Overlay */}\n      <div className=\"fixed inset-0 pointer-events-none bg-retro-scanlines opacity-[0.03]\" />\n\n      {/* Retro Signal Header */}\n      <header className=\"border-b border-white/10 bg-[#0f0f0f] sticky top-0 z-40 px-6 py-4\">\n        <div className=\"max-w-7xl mx-auto flex flex-wrap justify-between items-center gap-4\">\n          \n          <div className=\"flex items-center gap-3\">\n            <div className=\"relative w-8 h-8 rounded bg-amber-500 flex items-center justify-center text-black font-black italic shadow-lg shadow-amber-500/10\">\n              N\n            </div>\n            <div>\n              <div className=\"flex items-center gap-2\">\n                <h1 className=\"font-serif text-lg sm:text-xl font-light tracking-widest text-white uppercase\">\n                  Nostalgia Engine <span className=\"text-amber-500 font-sans text-[10px] align-top tracking-normal ml-2 opacity-70\">PROMPT GENERATOR v2.4</span>\n                </h1>\n              </div>\n              <p className=\"text-[10px] text-neutral-500 uppercase tracking-widest font-mono\">Viral First-Person Nostalgia Creator Workspace</p>\n            </div>\n          </div>\n\n          <div className=\"flex items-center gap-6\">\n            <div className=\"hidden lg:flex gap-6 text-[10px] uppercase tracking-[0.2em] font-semibold\">\n              <span className=\"text-amber-500 cursor-pointer\">Generator</span>\n              <span className=\"text-neutral-400 hover:text-white cursor-pointer transition-colors\">Archive</span>\n              <span className=\"text-neutral-400 hover:text-white cursor-pointer transition-colors\">Demographics</span>\n              <span className=\"text-neutral-400 hover:text-white cursor-pointer transition-colors\">Settings</span>\n            </div>\n\n            {/* Immersive HUD data */}\n            <div className=\"flex items-center gap-4 text-xs text-neutral-400 font-mono\">\n              <div className=\"hidden sm:block text-[10px]\">\n                <span className=\"text-neutral-500\">SEQ_</span>\n                <span className=\"text-amber-500 font-bold\">001_ACTIVE</span>\n              </div>\n              \n              <div className=\"flex items-center gap-1.5 bg-neutral-900 border border-white/5 px-2.5 py-1 rounded\">\n                <Clock className=\"w-3 h-3 text-neutral-500\" />\n                <span className=\"text-[11px] font-mono\">{currentTime || \"00:00:00\"}</span>\n              </div>\n            </div>\n          </div>\n\n        </div>\n      </header>\n\n      {/* Main Workspace Frame */}\n      <main className=\"max-w-7xl mx-auto px-6 pt-8\">\n        \n        {/* Banner */}\n        <div className=\"bg-[#0f0f0f] border border-white/10 p-6 sm:p-8 mb-8 relative overflow-hidden flex flex-col md:flex-row items-center gap-6 shadow-2xl\">\n          <div className=\"absolute inset-x-0 bottom-0 h-[1px] bg-gradient-to-r from-amber-500 via-yellow-500 to-transparent opacity-40\" />\n          \n          <div className=\"space-y-3 max-w-2xl text-center md:text-left\">\n            <div className=\"inline-flex items-center gap-1.5 bg-amber-500/10 border border-amber-500/20 text-amber-500 text-[10px] font-mono uppercase font-semibold px-2.5 py-0.5 rounded\">\n              <Sparkles className=\"w-3 h-3\" /> Viral POV Director Blueprint\n            </div>\n            <h2 className=\"text-2xl sm:text-4xl font-serif italic text-white tracking-normal leading-tight\">\n              The Saturday Morning Ritual\n            </h2>\n            <p className=\"text-neutral-400 text-sm font-light leading-relaxed\">\n              POV: A crisp, statics-charged memory where world scales are small, warm, and highly focused.\n              These parameters generate high-fidelity, demographically tuned image and video instructions tailored for TikTok, Reels, and YouTube Shorts creators.\n            </p>\n          </div>\n\n          <div className=\"md:ml-auto flex items-center justify-center bg-[#0a0a0a] p-4 border border-white/5 min-w-[200px] text-center shrink-0\">\n            <div className=\"space-y-1\">\n              <p className=\"text-[9px] text-neutral-500 uppercase tracking-widest\">Active Models</p>\n              <p className=\"text-xs font-bold text-neutral-300 font-mono\">Gemini 3.5 Flash</p>\n              <div className=\"h-[1px] bg-white/5 my-2\" />\n              <p className=\"text-[9px] text-neutral-500 uppercase tracking-widest\">Render Anchor</p>\n              <p className=\"text-[11px] text-amber-500 font-mono\">Gemini 2.5 Image</p>\n            </div>\n          </div>\n        </div>"
