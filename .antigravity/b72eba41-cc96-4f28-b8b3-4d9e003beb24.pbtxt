    replacement_chunks {
      replacement_content: "import React, { useState } from \"react\";\nimport { NostalgiaScene, SavedScene } from \"../types\";\nimport { Copy, Check, Tv, Sparkles, Sliders, RefreshCw, Bookmark, BookmarkCheck, FileText, Smartphone } from \"lucide-react\";\nimport { motion, AnimatePresence } from \"motion/react\";\n\ninterface PromptCardProps {\n  scene: NostalgiaScene;\n  decade: string;\n  theme: string;\n  onSave: (scene: NostalgiaScene) => void;\n  isSaved: boolean;\n}\n\nexport default function PromptCard({ scene, decade, theme, onSave, isSaved }: PromptCardProps) {\n  const [copiedImg, setCopiedImg] = useState(false);\n  const [copiedVid, setCopiedVid] = useState(false);\n  const [copiedScript, setCopiedScript] = useState(false);\n  \n  // Magic Live Preview states\n  const [isGeneratingImg, setIsGeneratingImg] = useState(false);\n  const [previewImage, setPreviewImage] = useState<string | null>(null);\n  const [previewError, setPreviewError] = useState<string | null>(null);\n\n  // Creative Sandbox states: modifying variables locally\n  const [isSandboxOpen, setIsSandboxOpen] = useState(false);\n  const [localDevice, setLocalDevice] = useState(scene.targetDevice);\n  const [localLighting, setLocalLighting] = useState(scene.lightingSource);\n  const [localItems, setLocalItems] = useState(scene.backgroundItems);\n  const [localMovement, setLocalMovement] = useState(scene.microMovement);\n  const [localLightChange, setLocalLightChange] = useState(scene.lightingChange);\n  \n  // Re-generate complete prompt formulas dynamically based on sandboxed values\n  const getAssembledImagePrompt = () => {\n    return `A raw, photorealistic first-person POV shot looking through the character\'s own eyes\342\200\224the scene is framed exactly as if the viewer is the character. Both forearms and wrists enter the frame from the bottom-left and bottom-right corners, gripping or interacting with ${localDevice}. The room is dimly lit by ${localLighting}. The background features ${localItems}. No part of the character\'s face, hair, shoulders, or side-profile is visible. The camera is locked inside the head at eye level, looking slightly downward at the hands. Shot on 35mm film with slight grain and an amateur, lived-in feel.`;\n  };\n\n  const getAssembledVideoPrompt = () => {\n    return `The camera gently sways with subtle breathing motion, slightly unsteady as if sitting naturally. The hands remain mostly stationary with only small, repetitive gestures\342\200\224${localMovement}. The lighting ${localLightChange}. The motion remains grounded and natural\342\200\224no dramatic movements, just the quiet, immersive feeling of someone deeply absorbed in a nostalgic moment.`;\n  };\n\n  const handleCopyText = (text: string, setCopiedState: (v: boolean) => void) => {\n    navigator.clipboard.writeText(text);\n    setCopiedState(true);\n    setTimeout(() => setCopiedState(false), 2000);\n  };\n\n  const handleCopyScriptBundle = () => {\n    const fullScript = `\360\237\216\254 POV NOSTALGIA VIDEO CONCEPT\n\nTitle: Scene ${scene.number} - ${scene.title}\nTheme Focus: ${theme || decade}\n\n\360\237\223\267 IMAGE PROMPT (Create Scene Background):\n${getAssembledImagePrompt()}\n\n\360\237\216\245 VIDEO PROMPT (Animate Hands & Vibe):\n${getAssembledVideoPrompt()}\n\n\360\237\216\265 RECOMMENDED SOUND/MUSIC OVERLAY:\n\"Low-fidelity warbling synthesizer tracks, muffled VHS dust crackling sounds, and high-frequency analog television whine.\"\n\n\360\237\223\261 VIRAL POINTERS & HASHTAGS:\n- Let the hands hold still, micro-gesturing slowly. Let light glint off the dials.\n- Caption Idea: \" POV: You are 11 years old. It is a rainy Friday afternoon in 1996.\"\n- Tags: #POV #Nostalgia #Retro #VintagePOV #FirstPerson #Cinematic #AIVideo #TikTokReels #90sAesthetics #1980s`;\n\n    handleCopyText(fullScript, setCopiedScript);\n  };\n\n  // Triggers backend Imagen/Gemini 2.5 Image generation\n  const handleGeneratePreview = async () => {\n    setIsGeneratingImg(true);\n    setPreviewError(null);\n    setPreviewImage(null);\n\n    try {\n      const response = await fetch(\"/api/generate-image-preview\", {\n        method: \"POST\",\n        headers: { \"Content-Type\": \"application/json\" },\n        body: JSON.stringify({ promptText: getAssembledImagePrompt() })\n      });\n\n      const data = await response.json();\n      if (!response.ok) {\n        throw new Error(data.error || \"Generation error\");\n      }\n\n      setPreviewImage(data.imageData);\n    } catch (err: any) {\n      console.warn(\"Unable to generate live render. Using aesthetic retro styling CSS container instead.\", err);\n      setPreviewError(err.message || \"Model failed / key limit. Prompt is perfectly safe and generated!\");\n    } finally {\n      setIsGeneratingImg(false);\n    }\n  };\n\n  const imagePromptText = getAssembledImagePrompt();\n  const videoPromptText = getAssembledVideoPrompt();\n\n  return (\n    <motion.div\n      id={`scene-card-${scene.number}`}\n      initial={{ opacity: 0, y: 30 }}\n      animate={{ opacity: 1, y: 0 }}\n      transition={{ duration: 0.5, delay: scene.number * 0.1 }}\n      className=\"bg-neutral-900 border-2 border-neutral-800 rounded-2xl overflow-hidden shadow-2xl relative\"\n    >\n      {/* Tape Roll Edge decoration */}\n      <div className=\"absolute top-0 left-0 w-2 h-full bg-repeating-stripes opacity-30 pointer-events-none\" />\n\n      {/* Card Header */}\n      <div className=\"bg-neutral-950 p-5 border-b border-neutral-800 flex flex-wrap justify-between items-center gap-4 pl-8\">\n        <div className=\"flex items-center gap-3\">\n          <span className=\"flex items-center justify-center bg-amber-500/10 border border-amber-500/30 text-amber-500 font-mono text-sm px-3 py-1 rounded-md font-bold tracking-wider\">\n            SCENE 0{scene.number}\n          </span>\n          <h3 className=\"text-xl font-bold text-neutral-100 tracking-tight\">\n            {scene.title}\n          </h3>\n        </div>\n\n        {/* Action controls */}\n        <div className=\"flex items-center gap-2\">\n          <button\n            onClick={() => onSave(scene)}\n            className={`flex items-center gap-2 px-3 py-1.5 rounded-lg border text-sm font-medium transition-all ${\n              isSaved\n                ? \"bg-amber-500/10 border-amber-500/50 text-amber-500\"\n                : \"bg-neutral-800/80 border-neutral-700 text-neutral-300 hover:text-white hover:bg-neutral-800\"\n            }`}\n            title=\"Save for Concept Library\"\n          >\n            {isSaved ? <BookmarkCheck className=\"w-4 h-4\" /> : <Bookmark className=\"w-4 h-4\" />}\n            {isSaved ? \"Saved\" : \"Save Concept\"}\n          </button>\n\n          <button\n            onClick={() => setIsSandboxOpen(!isSandboxOpen)}\n            className={`p-2 rounded-lg border text-sm transition-all ${\n              isSandboxOpen\n                ? \"bg-amber-500/15 border-amber-500/50 text-amber-500\"\n                : \"bg-neutral-800/80 border-neutral-700 text-neutral-400 hover:text-white\"\n            }`}\n            title=\"Tweak Ingredients Sandbox\"\n          >\n            <Sliders className=\"w-4 h-4\" />\n          </button>\n        </div>\n      </div>\n\n      {/* Grid Layout: Left is Details & Sandbox, Right is Prompt outputs and Preview */}\n      <div className=\"grid grid-cols-1 lg:grid-cols-2\">\n        \n        {/* Left Side: Nostalgic Blueprint details */}\n        <div className=\"p-6 border-b lg:border-b-0 lg:border-r border-neutral-800 pl-8 bg-neutral-950/20\">\n          <h4 className=\"text-xs font-mono uppercase tracking-widest text-amber-500/70 mb-4 flex items-center gap-1.5\">\n            <Sparkles className=\"w-3.5 h-3.5\" /> Nostalgic Frame Composition\n          </h4>\n\n          {/* Variables Stack */}\n          <div className=\"space-y-4\">\n            <div className=\"p-3 bg-neutral-900/60 rounded-xl border border-neutral-800/60\">\n              <span className=\"text-[10px] font-mono text-neutral-500 block uppercase tracking-wider mb-1\">\360\237\216\256 Cultural Target Device</span>\n              <p className=\"text-neutral-200 text-sm font-medium\">{localDevice}</p>\n            </div>\n\n            <div className=\"p-3 bg-neutral-900/60 rounded-xl border border-neutral-800/60\">\n              <span className=\"text-[10px] font-mono text-neutral-500 block uppercase tracking-wider mb-1\">\360\237\222\241 Ambient Light Source</span>\n              <p className=\"text-neutral-200 text-sm font-medium\">{localLighting}</p>\n            </div>\n\n            <div className=\"p-3 bg-neutral-900/60 rounded-xl border border-neutral-800/60\">\n              <span className=\"text-[10px] font-mono text-neutral-500 block uppercase tracking-wider mb-1\">\360\237\223\246 Background Scattered Relics</span>\n              <p className=\"text-neutral-200 text-sm font-medium\">{localItems}</p>\n            </div>\n\n            <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-3\">\n              <div className=\"p-3 bg-neutral-900/60 rounded-xl border border-neutral-800/60\">\n                <span className=\"text-[10px] font-mono text-neutral-500 block uppercase tracking-wider mb-1\">\360\237\226\220\357\270\217 Breathing Micro-Action</span>\n                <p className=\"text-neutral-200 text-xs font-medium\">{localMovement}</p>\n              </div>\n              <div className=\"p-3 bg-neutral-900/60 rounded-xl border border-neutral-800/60\">\n                <span className=\"text-[10px] font-mono text-neutral-500 block uppercase tracking-wider mb-1\">\342\232\241 Dynamic Aura Shift</span>\n                <p className=\"text-neutral-200 text-xs font-medium\">{localLightChange}</p>\n              </div>\n            </div>\n          </div>\n\n          {/* Sandbox Editor Toggled */}\n          <AnimatePresence>\n            {isSandboxOpen && (\n              <motion.div\n                initial={{ opacity: 0, height: 0 }}\n                animate={{ opacity: 1, height: \"auto\" }}\n                exit={{ opacity: 0, height: 0 }}\n                transition={{ duration: 0.3 }}\n                className=\"mt-5 pt-5 border-t border-dashed border-neutral-800 space-y-4\"\n              >\n                <div className=\"flex items-center justify-between\">\n                  <h5 className=\"text-xs font-mono font-bold text-amber-500/80 uppercase\">\360\237\224\254 Prompt Refiner Sandbox</h5>\n                  <button \n                    onClick={() => {\n                      setLocalDevice(scene.targetDevice);\n                      setLocalLighting(scene.lightingSource);\n                      setLocalItems(scene.backgroundItems);\n                      setLocalMovement(scene.microMovement);\n                      setLocalLightChange(scene.lightingChange);\n                    }}\n                    className=\"text-[10px] font-mono text-neutral-400 hover:text-white flex items-center gap-1\"\n                  >\n                    <RefreshCw className=\"w-2.5 h-2.5\" /> Revert Variables\n                  </button>\n                </div>\n\n                <div className=\"space-y-3 text-xs\">\n                  <div>\n                    <label className=\"text-neutral-400 block mb-1\">Target Object / Device:</label>\n                    <input\n                      type=\"text\"\n                      value={localDevice}\n                      onChange={(e) => setLocalDevice(e.target.value)}\n                      className=\"w-full bg-neutral-900 border border-neutral-800 rounded-lg p-2 text-white focus:outline-none focus:border-amber-500/50\"\n                    />\n                  </div>\n                  <div>\n                    <label className=\"text-neutral-400 block mb-1\">Lighting Source & Tone:</label>\n                    <input\n                      type=\"text\"\n                      value={localLighting}\n                      onChange={(e) => setLocalLighting(e.target.value)}\n                      className=\"w-full bg-neutral-900 border border-neutral-800 rounded-lg p-2 text-white focus:outline-none focus:border-amber-500/50\"\n                    />\n                  </div>\n                  <div>\n                    <label className=\"text-neutral-400 block mb-1\">Background Relics:</label>\n                    <input\n                      type=\"text\"\n                      value={localItems}\n                      onChange={(e) => setLocalItems(e.target.value)}\n                      className=\"w-full bg-neutral-900 border border-neutral-800 rounded-lg p-2 text-white focus:outline-none focus:border-amber-500/50\"\n                    />\n                  </div>\n                  <div className=\"grid grid-cols-2 gap-2\">\n                    <div>\n                      <label className=\"text-neutral-400 block mb-1\">Micro Gesture:</label>\n                      <input\n                        type=\"text\"\n                        value={localMovement}\n                        onChange={(e) => setLocalMovement(e.target.value)}\n                        className=\"w-full bg-neutral-900 border border-neutral-800 rounded-lg p-2 text-white text-[11px] focus:outline-none focus:border-amber-500/50\"\n                      />\n                    </div>\n                    <div>\n                      <label className=\"text-neutral-400 block mb-1\">Lighting Change:</label>\n                      <input\n                        type=\"text\"\n                        value={localLightChange}\n                        onChange={(e) => setLocalLightChange(e.target.value)}\n                        className=\"w-full bg-neutral-900 border border-neutral-800 rounded-lg p-2 text-white text-[11px] focus:outline-none focus:border-amber-500/50\"\n                      />\n                    </div>\n                  </div>\n                </div>\n              </motion.div>\n            )}\n          </AnimatePresence>\n        </div>\n\n        {/* Right Side: Render Prompts & Live Negative View */}\n        <div className=\"p-6 space-y-5 flex flex-col justify-between\">\n          <div className=\"space-y-4\">\n            \n            {/* Image Prompt Display */}\n            <div>\n              <div className=\"flex justify-between items-center mb-1.5\">\n                <span className=\"text-[11px] font-mono uppercase tracking-wider text-neutral-400 flex items-center gap-1\">\n                  \360\237\223\270 Image Prompt Formula\n                </span>\n                <button\n                  onClick={() => handleCopyText(imagePromptText, setCopiedImg)}\n                  className=\"text-neutral-400 hover:text-amber-500 text-xs flex items-center gap-1 font-mono transition-colors\"\n                >\n                  {copiedImg ? (\n                    <>\n                      <Check className=\"w-3.5 h-3.5 text-green-500\" />\n                      <span className=\"text-green-500 font-bold\">COPIED</span>\n                    </>\n                  ) : (\n                    <>\n                      <Copy className=\"w-3.5 h-3.5\" />\n                      <span>Copy</span>\n                    </>\n                  )}\n                </button>\n              </div>\n              <div className=\"bg-neutral-950 p-3 rounded-lg border border-neutral-800 text-xs text-neutral-300 font-mono leading-relaxed select-all hover:border-neutral-700 transition-colors h-24 overflow-y-auto scrollbar-thin\">\n                {imagePromptText}\n              </div>\n            </div>\n\n            {/* Video Prompt Display */}\n            <div>\n              <div className=\"flex justify-between items-center mb-1.5\">\n                <span className=\"text-[11px] font-mono uppercase tracking-wider text-neutral-400 flex items-center gap-1\">\n                  \360\237\216\245 Video Prompt / Animation Formula\n                </span>\n                <button\n                  onClick={() => handleCopyText(videoPromptText, setCopiedVid)}\n                  className=\"text-neutral-400 hover:text-amber-500 text-xs flex items-center gap-1 font-mono transition-colors\"\n                >\n                  {copiedVid ? (\n                    <>\n                      <Check className=\"w-3.5 h-3.5 text-green-500\" />\n                      <span className=\"text-green-500 font-bold\">COPIED</span>\n                    </>\n                  ) : (\n                    <>\n                      <Copy className=\"w-3.5 h-3.5\" />\n                      <span>Copy</span>\n                    </>\n                  )}\n                </button>\n              </div>\n              <div className=\"bg-neutral-950 p-3 rounded-lg border border-neutral-800 text-xs text-neutral-300 font-mono leading-relaxed select-all hover:border-neutral-700 transition-colors h-24 overflow-y-auto scrollbar-thin\">\n                {videoPromptText}\n              </div>\n            </div>\n\n          </div>\n\n          {/* Magic Frame & Generation */}\n          <div className=\"border border-neutral-800 rounded-xl bg-neutral-950 p-4 space-y-4\">\n            \n            {/* Visual Screen Container */}\n            <div className=\"relative aspect-video rounded-lg overflow-hidden bg-neutral-900 border border-neutral-800 flex flex-col items-center justify-center text-center\">\n              \n              {/* Retro Viewport Grid Overlay */}\n              <div className=\"absolute inset-0 bg-retro-scanlines opacity-25 pointer-events-none\" />\n\n              <AnimatePresence mode=\"wait\">\n                {isGeneratingImg ? (\n                  <motion.div\n                    key=\"generating\"\n                    initial={{ opacity: 0 }}\n                    animate={{ opacity: 1 }}\n                    exit={{ opacity: 0 }}\n                    className=\"flex flex-col items-center gap-2 p-4 text-center z-10\"\n                  >\n                    <Tv className=\"w-8 h-8 text-amber-500 animate-pulse\" />\n                    <span className=\"text-xs font-mono text-amber-500 tracking-wider\">DEVELOPING 35MM REELS...</span>\n                    {/* Retro Progress bar animation */}\n                    <div className=\"w-32 h-1 bg-neutral-800 rounded-full overflow-hidden mt-1\">\n                      <div className=\"h-full bg-amber-500 animate-loading-bar\" />\n                    </div>\n                    <span className=\"text-[10px] text-neutral-500 font-mono\">Generates base negative via gemini-2.5-flash-image</span>\n                  </motion.div>\n                ) : previewImage ? (\n                  <motion.div\n                    key=\"image\"\n                    initial={{ opacity: 0 }}\n                    animate={{ opacity: 1 }}\n                    className=\"w-full h-full relative\"\n                  >\n                    <img\n                      src={previewImage}\n                      alt=\"Nostalgic POV visual scene render\"\n                      className=\"w-full h-full object-cover\"\n                      referrerPolicy=\"no-referrer\"\n                    />\n                    <div className=\"absolute bottom-2 left-2 bg-black/80 backdrop-blur-md px-2 py-0.5 rounded border border-neutral-800 text-[9px] font-mono text-amber-400\">\n                      POV MODEL ACTIVE RENDER 1.0\n                    </div>\n                  </motion.div>\n                ) : (\n                  <motion.div\n                    key=\"placeholder\"\n                    initial={{ opacity: 0 }}\n                    animate={{ opacity: 1 }}\n                    className=\"p-5 flex flex-col items-center gap-1.5 text-center text-neutral-500\"\n                  >\n                    <Tv className=\"w-10 h-10 stroke-[1.5] text-neutral-600\" />\n                    <p className=\"text-xs font-mono font-bold text-neutral-400\">CRT POV SCREEN SHOT</p>\n                    <p className=\"text-[11px] text-neutral-500 max-w-xs leading-normal\">\n                      Click below to generate a real AI image draft using your generated specs.\n                    </p>\n                    {previewError && (\n                      <div className=\"mt-1 px-2.5 py-1 rounded bg-red-950/40 border border-red-900/40 text-[10px] text-red-400 font-mono\">\n                        {previewError}\n                      </div>\n                    )}\n                  </motion.div>\n                )}\n              </AnimatePresence>\n            </div>\n\n            {/* Render and Script copy controls */}\n            <div className=\"flex gap-2.5 flex-wrap\">\n              <button\n                onClick={handleGeneratePreview}\n                disabled={isGeneratingImg}\n                className=\"flex-1 min-w-[150px] bg-amber-500 hover:bg-amber-400 text-neutral-950 font-bold px-3.5 py-2 rounded-lg text-xs font-mono transition-all flex items-center justify-center gap-2 cursor-pointer shadow-lg active:scale-[0.98] disabled:opacity-50\"\n              >\n                <Sparkles className=\"w-4 h-4 text-neutral-950\" />\n                {previewImage ? \"Regenerate Render\" : \"Generate Draft Preview\"}\n              </button>\n\n              <button\n                onClick={handleCopyScriptBundle}\n                className=\"bg-neutral-800 hover:bg-neutral-700 text-neutral-200 border border-neutral-700 px-3.5 py-2 rounded-lg text-xs font-semibold tracking-wide transition-all flex items-center justify-center gap-2 cursor-pointer\"\n                title=\"Copy ready-to-post script with visual hashtags & specs\"\n              >\n                {copiedScript ? (\n                  <>\n                    <Check className=\"w-4 h-4 text-green-500\" />\n                    <span className=\"text-green-500\">Copied Bundle</span>\n                  </>\n                ) : (\n                  <>\n                    <FileText className=\"w-4 h-4\" />\n                    <span>Copy Reels Bundle</span>\n                  </>\n                )}\n              </button>\n            </div>\n\n          </div>\n\n        </div>\n\n      </div>\n\n    </motion.div>\n  );\n}\n"
    }
