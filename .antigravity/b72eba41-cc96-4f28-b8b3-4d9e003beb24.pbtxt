                 style={{ width: `${loadingProgress}%` }}\n                        />\n                      </div>\n\n                      <p className=\"text-neutral-200 font-bold text-sm h-6 overflow-hidden\">\n                        {RETRO_LOADING_PHRASES[loadingMsgIndex]}\n                      </p>\n                      <p className=\"text-[11px] text-neutral-500 font-mono\">\n                        Sending prompt parameters via deep server-side Gemini 3.5 AI...\n                      </p>\n                    </div>\n                  </div>\n                </motion.div>\n              )}\n            </AnimatePresence>\n\n            {/* Scene Cards List on Success */}\n            {!isGenerating && scenes.length > 0 && (\n              <div className=\"space-y-8\">\n                \n                <div className=\"flex items-center justify-between\">\n                  <h3 className=\"text-lg font-bold text-neutral-100 flex items-center gap-2\">\n                    <ListChecks className=\"w-5 h-5 text-amber-500/80\" /> Generated Storyboard concepts\n                  </h3>\n                  <span className=\"text-xs font-mono text-neutral-500\">\n                    Showing 5 high-fidelity scenes\n                  </span>\n                </div>\n\n                <div className=\"space-y-6\">\n                  {scenes.map((scene) => (\n                    <PromptCard\n                      key={scene.number}\n                      scene={scene}\n                      decade={selectedDecade || \"\"}\n                      theme={customTheme || \"\"}\n                      onSave={handleSaveScene}\n                      isSaved={isSceneSaved(scene)}\n                    />\n                  ))}\n                </div>\n\n              </div>\n            )}\n\n          </div>\n\n          {/* Column 3: Saved Workspace & Viral Playbook */}\n          <div className=\"space-y-8\">\n            \n            {/* Saved concept rolls library */}\n            <SavedDrawer\n              savedScenes={savedScenes}\n              onRemove={handleRemoveSaved}\n              onClearAll={handleClearSaved}\n            />\n\n            {/* Playbook instructions */}\n            <div className=\"bg-neutral-900 border-2 border-neutral-800 rounded-2xl p-6 shadow-xl relative overflow-hidden\">\n              <div className=\"absolute top-0 right-0 w-24 h-24 bg-amber-500/5 blur-2xl rounded-full\" />\n              \n              <h3 className=\"text-sm font-mono font-bold text-neutral-300 uppercase tracking-widest flex items-center gap-2 mb-4\">\n                <Layers className=\"w-4.5 h-4.5 text-amber-500\" /> Director\'s viral guidebook\n              </h3>\n\n              <div className=\"space-y-4 text-xs font-mono text-neutral-400\">\n                <p className=\"leading-relaxed\">\n                  How actual creators turn these detailed prompts into 5,000,000+ view viral clips:\n                </p>\n\n                <div className=\"space-y-3.5\">\n                  <div className=\"flex gap-2.5 items-start\">\n                    <span className=\"bg-neutral-800 border border-neutral-700 text-[10px] px-1.5 py-0.5 rounded text-neutral-300 shrink-0\">1</span>\n                    <p className=\"leading-normal\">\n                      Copy the <b className=\"text-neutral-200\">Image Prompt</b> from any card on the left.\n                    </p>\n                  </div>\n\n                  <div className=\"flex gap-2.5 items-start\">\n                    <span className=\"bg-neutral-800 border border-neutral-700 text-[10px] px-1.5 py-0.5 rounded text-neutral-300 shrink-0\">2</span>\n                    <p className=\"leading-normal\">\n                      Feed it to your favorite image generator (e.g. Midjourney v6, FLUX, DALL-E) to render the base first-person frame with grain.\n                    </p>\n                  </div>\n\n                  <div className=\"flex gap-2.5 items-start\">\n                    <span className=\"bg-neutral-800 border border-neutral-700 text-[10px] px-1.5 py-0.5 rounded text-neutral-300 shrink-0\">3</span>\n                    <p className=\"leading-normal\">\n                      Upload your output image as the <b>starting keyframe</b> inside modern animators like Luma Dream Machine, Kling AI, or Runway Gen-3.\n                    </p>\n                  </div>\n\n                  <div className=\"flex gap-2.5 items-start\">\n                    <span className=\"bg-neutral-800 border border-neutral-700 text-[10px] px-1.5 py-0.5 rounded text-neutral-300 shrink-0\">4</span>\n                    <p className=\"leading-normal\">\n                      Copy our generated <b className=\"text-neutral-200\">Video Prompt</b> into the description motion controller input field. This tells the generator to animate only minor finger movements.\n                    </p>\n                  </div>\n\n                  <div className=\"flex gap-2.5 items-start\">\n                    <span className=\"bg-neutral-800 border border-neutral-700 text-[10px] px-1.5 py-0.5 rounded text-neutral-300 shrink-0\">5</span>\n                    <p className=\"leading-normal\">\n                      Sync with muffled cassette tapes or warm lo-fi background tracks. Watch the comments overflow!\n                    </p>\n                  </div>\n                </div>\n\n                <div className=\"h-px bg-neutral-800 my-4\" />\n\n                <div className=\"bg-neutral-950 p-3 rounded border border-neutral-800\">\n                  <span className=\"text-[10px] font-bold text-amber-500 uppercase flex items-center gap-1 mb-1\">\n                    <Info className=\"w-3 h-3\" /> PRO TIP: Use Brackets\n                  </span>\n                  <p className=\"text-[10.5px] leading-relaxed text-neutral-500 font-sans\">\n                    Most video generation systems produce optimal results when hands are relatively static. Small micro-motions keep the visual consistent.\n                  </p>\n                </div>\n              </div>\n\n            </div>\n\n          </div>\n\n        </div>\n\n      </main>\n\n      {/* Footer info */}\n      <footer className=\"mt-20 border-t border-neutral-900 bg-neutral-950 py-10 px-6 sm:px-12 text-center text-xs font-mono text-neutral-500 space-y-3\">\n        <div className=\"flex items-center justify-center gap-2 text-neutral-400\">\n          <Tv className=\"w-4 h-4 text-amber-500\" />\n          <span>AI Nostalgia POV Prompter Suite</span>\n        </div>\n        <p>Built with Google Cloud Server-Side Gemini API and styled with custom Tailwind CSS rules.</p>\n        <p className=\"text-neutral-600\">Secure Key Architecture \342\200\242 Telemetry User-Agent Active</"
